# ============================================================================
# TEST ENVIRONMENT — VERSIONED IN GIT, DUMMY VALUES ONLY
# ============================================================================
#
# This file is loaded by `api/tests/setup/env.js` with `override: true` BEFORE
# any application module is required, so it wins over variables already present
# in the process environment (in Docker the preprod values arrive via `env_file`,
# and a plain dotenv load would NOT override them).
#
# NEVER put a real credential here. Every value below is synthetic and exists
# only to satisfy the startup validation in `api/config/env.js`. Personal
# overrides belong in `.env.test.local`, which is gitignored.
#
# Two guarantees are enforced in code, not just here:
#   - `api/config/database.js` aborts the process if NODE_ENV=test and the
#     database URL is not a local `file:` URL.
#   - `api/services/emailService.js` refuses to contact any provider when the
#     email transport is `noop`.
# ============================================================================

NODE_ENV=test
LOG_LEVEL=silent
PORT=3001
CLIENT_URL=http://localhost:3000

# --- Database: local SQLite file through the same libsql client -------------
# Recreated from scratch by tests/setup/globalSetup.js and deleted on teardown.
# Must start with `file:` or the guard in config/database.js aborts the run.
TURSO_DATABASE_URL=file:./.tmp/test.db
# No auth token: config/env.js only requires it for remote URLs.
TURSO_AUTH_TOKEN=

# --- Auth -------------------------------------------------------------------
JWT_SECRET=test-jwt-secret-not-a-real-key
JWT_EXPIRES_IN=1h

# --- Email: inert transport, no provider is ever contacted ------------------
EMAIL_TRANSPORT=noop
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_test_dummy_key
EMAIL_FROM=test@example.invalid
REGISTRATION_EMAIL=test@example.invalid
BUSINESS_EMAIL=test@example.invalid
MARKETING_EMAILS_ENABLED=false

# --- Database backups: deliberately asked for, and still refused ------------
# This is set to `true` on purpose. `config.backup.enabled` ANDs it with
# `nodeEnv !== 'test'`, so the switch being on here is what makes the assertion
# in tests/dbBackup.test.js meaningful: the environment file asks for backups
# and the code refuses anyway. Never remove this to "fix" a test.
DB_BACKUP_ENABLED=true
AWS_S3_BACKUP_BUCKET=

# --- Payments ---------------------------------------------------------------
# The Stripe SDK throws at construction on an empty key, so a syntactically
# valid dummy is needed. It authenticates against nothing: any real API call
# fails with an auth error, which is the desired outcome — tests must mock
# stripeService, never reach Stripe.
STRIPE_SECRET_KEY=sk_test_dummy000000000000000000000000
STRIPE_WEBHOOK_SECRET=whsec_test_dummy
STRIPE_CONNECT_ENABLED=false
PAYMENT_PROVIDER=stripe

# --- NTAG 424 DNA (CoA): synthetic keys of the exact required length --------
# 3 bytes / 16 bytes / 16 bytes of hex. Tests derive and verify with these, so
# they are internally consistent; they match no physical sticker in existence.
NTAG424_SYSTEM_ID=000102
NTAG424_K_PICC=000102030405060708090a0b0c0d0e0f
NTAG424_MASTER_KEY=101112131415161718191a1b1c1d1e1f
IP_HASH_SALT=202122232425262728292a2b2c2d2e2f

# --- Sendcloud / streaming: disabled, no outbound calls ---------------------
SENDCLOUD_ENABLED_ART=false
SENDCLOUD_ENABLED_OTHERS=false
SENDCLOUD_API_KEY=
SENDCLOUD_API_SECRET=
TURNSTILE_SECRET=

# --- Rate limiting: high ceilings so limiters never fail a test -------------
GENERAL_RATE_LIMIT_MAX_REQUESTS=100000
AUTH_RATE_LIMIT_MAX_REQUESTS=100000
SENSITIVE_RATE_LIMIT_MAX_REQUESTS=100000
COA_VERIFY_RATE_LIMIT_MAX_REQUESTS=100000
INQUIRY_RATE_LIMIT_MAX_REQUESTS=100000
