# DEPLOYMENT NOTE — Multi-image product schema (change: multi-image-products)
# This change removes the `basename` column from `art`, `others`, and `other_vars`
# and introduces a new polymorphic `product_images` table. Because
# `initializeDatabase()` is idempotent (CREATE TABLE IF NOT EXISTS), it will
# NOT alter existing tables. Before deploying the new code, the operator must
# manually drop the affected tables ONCE:
#
#   DROP TABLE art; DROP TABLE others; DROP TABLE other_vars;
#
# `initializeDatabase()` will then recreate them on the next startup without
# the legacy `basename` column. No data migration is performed; existing
# products are discarded as part of this change.

# Server Configuration
PORT=3001
NODE_ENV=development

# Turso Database Configuration
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your_auth_token_here

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Sentry
# Sampling rates for traces and profiles (0.0 - 1.0).
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
# Escape hatch: reporting is OFF in development, because every issue that ever
# arrived from a local machine was an artefact of the edit-save-reload cycle
# (Fast Refresh transients, nodemon restarting on a half-written file), never a
# real defect. Set to the literal 'true' to report from local anyway — useful
# only when debugging the Sentry integration itself. NO EFFECT outside
# NODE_ENV=development: staging and production always report, and NODE_ENV=test
# never imports Sentry at all.
SENTRY_ENABLE_DEV=

# AWS Settings
# When AWS_S3_BUCKET is empty, S3 is considered not configured: uploads and
# backups fail loudly, but GET /api/stories/videos degrades to an empty list
# (200) instead of a 500. Staging deliberately runs without it.
AWS_S3_BUCKET=140d-media-pro-243303976956-eu-south-2-an
AWS_S3_REGION=eu-south-2
CDN_BASE_URL=https://cdn.140d.art

# Database backups to S3 (see docs/backups-s3.md)
# Daily dump of the Turso database at 04:00 Europe/Madrid, uploaded to a
# DEDICATED bucket — never the media bucket above, which has a different
# lifecycle and a policy that allows deletion.
#
# No AWS credentials are needed here: s3Service creates the S3 client without
# explicit credentials and the EC2 instance role supplies them through the
# SDK's default chain. The role's policy grants ONLY s3:PutObject on the backup
# bucket (no GetObject, no DeleteObject), so the api can write a copy but can
# never read one back or delete it.
#
# Only production is configured today. Leave these empty in local and staging:
# with DB_BACKUP_ENABLED unset the scheduler does not start at all. Under
# NODE_ENV=test backups are disabled no matter what is set here.
DB_BACKUP_ENABLED=false
AWS_S3_BACKUP_BUCKET=
# Optional — defaults to AWS_S3_REGION. Only needed if the backup bucket lives
# in a different region than the media bucket.
AWS_S3_BACKUP_REGION=
# Optional — cron expression, always evaluated in Europe/Madrid.
DB_BACKUP_CRON='0 4 * * *'

# Transactional email provider: 'resend' (default) or 'smtp' (legacy Nodemailer,
# kept as a switchable rollback — set EMAIL_PROVIDER=smtp to revert without a redeploy).
EMAIL_PROVIDER=resend

# Email transport: 'live' (default) or 'noop'. Orthogonal to EMAIL_PROVIDER —
# the provider says WHICH service would be used, the transport says WHETHER
# anything leaves the process. With 'noop' no Resend call and no SMTP connection
# is made (transactional AND marketing); messages go to an in-memory outbox.
# Forced to 'noop' under NODE_ENV=test so a test run can never mail a real
# recipient. Set it explicitly for a local environment that must stay silent.
EMAIL_TRANSPORT=live

# Resend HTTP API key. Required only when EMAIL_PROVIDER=resend.
# The From address (EMAIL_FROM) must belong to a domain verified in Resend
# (e.g. the subdomain send.140d.art → info@send.140d.art).
RESEND_API_KEY=re_your_api_key

# SMTP Email Configuration (legacy fallback; required only when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# From address used by both providers. With Resend it must match the verified
# domain (info@send.140d.art); the display name "140d Galería de Arte" is added in code.
EMAIL_FROM=info@send.140d.art

# Public URL for the email logo. When set, the logo is referenced by URL instead
# of being attached inline (CID) — more reliable in Gmail and required for Resend.
LOGO_URL=https://cdn.140d.art/140d.png

# ---------------------------------------------------------------------------
# Marketing email (Resend Broadcasts) — distinct from the transactional config
# ---------------------------------------------------------------------------
# Circuit breaker for all marketing broadcasts. Default OFF (fail-safe). When
# false (or when RESEND_MARKETING_API_KEY is empty) the app never calls Resend
# for marketing — useful for local dev. Set true in staging AND production.
MARKETING_EMAILS_ENABLED=false

# Dedicated FULL-ACCESS Resend API key (NOT the send-only transactional key).
# Required only when MARKETING_EMAILS_ENABLED=true. Broadcasts need management
# permissions the send-only key does not have.
RESEND_MARKETING_API_KEY=re_your_full_access_key

# Newsletter segment the broadcasts target. IMPORTANT: set this to a TEST segment
# (your own test contacts, subscribed to the topics below) outside production, and
# to the REAL segment in production. Same variable, different value per environment.
RESEND_NEWSLETTER_SEGMENT_ID=

# Topic IDs the announcements are scoped to (Resend delivers to segment ∩ topic).
RESEND_TOPIC_NEW_AUTHORS=
RESEND_TOPIC_AUCTIONS_DRAWS=
RESEND_TOPIC_LIVE_EVENTS=
# The monthly "Newsletter" topic (26f1a32f-ef3d-4159-bd84-4a9ed83daa13). The
# newsletter broadcast itself is still sent manually from the Resend UI, but the
# public signup form offers this topic as an opt-in option, so the backend needs
# its ID. Required only when MARKETING_EMAILS_ENABLED=true (like the others).
RESEND_TOPIC_NEWSLETTER=

# From address for marketing broadcasts. Optional — defaults to EMAIL_FROM.
# The "140d Galería de Arte" display name is added in code.
MARKETING_FROM=

# CORS Configuration
CLIENT_URL=http://localhost:3000

# Dealer commission is now per-seller (users.dealer_commission_art /
# users.dealer_commission_other), editable from the admin author screen. The
# former global DEALER_COMMISSION_ART / DEALER_COMMISSION_OTHERS vars are gone.

# VAT is per-seller (users.tax_vat_art / users.tax_vat_other), edited by the
# admin. TAX_VAT_ES is legacy-only: it survives solely for the Revolut line item
# metadata (ordersController.placeOrder). TAX_VAT_ART_ES has been removed.
TAX_VAT_ES=0.21

# Registration Request Email
REGISTRATION_EMAIL=axgalache@gmail.com

# Payment Provider: 'revolut' or 'stripe'
PAYMENT_PROVIDER=revolut

# Stripe (Payments) - required when PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Connect (Change #1: stripe-connect-accounts, Change #2: stripe-connect-manual-payouts)
# Change #2 reuses the same vars — no new env vars required. The webhook endpoint must
# be extended in the Stripe Dashboard to also deliver `transfer.created`, `transfer.reversed`
# and `transfer.failed` events on top of the account events subscribed in Change #1.
# Enable Stripe Connect features. Set to true once Connect is activated in the Stripe Dashboard.
STRIPE_CONNECT_ENABLED=false
# URL where Stripe redirects the artist when an account link expires (must be public).
STRIPE_CONNECT_REFRESH_URL=https://pre.140d.art/seller/stripe-connect/refresh
# URL where Stripe redirects the artist after completing the onboarding (must be public).
STRIPE_CONNECT_RETURN_URL=https://pre.140d.art/seller/stripe-connect/return
# Webhook signing secret for the Connect webhook endpoint (DIFFERENT from STRIPE_WEBHOOK_SECRET).
# Get it from Stripe Dashboard -> Webhooks -> <connect endpoint> -> Signing secret.
STRIPE_CONNECT_WEBHOOK_SECRET=

# Revolut Merchant (Payments) - required when PAYMENT_PROVIDER=revolut
# Mode: 'sandbox' or 'production'
REVOLUT_MODE=sandbox
# Secret API key from Revolut Business (Sandbox or Production)
REVOLUT_SECRET_KEY=your_revolut_secret_key
# Merchant Account ID (retrieve via dashboard or API)
REVOLUT_MERCHANT_ACCOUNT_ID=your_merchant_account_id
# Webhook signing secret (configure in Revolut dashboard when creating the webhook)
REVOLUT_WEBHOOK_SECRET=your_webhook_secret
# Public API URLs per mode (override if different from defaults)
REVOLUT_API_URL_SANDBOX=https://sandbox-merchant.revolut.com/api/merchant/1.0
REVOLUT_API_URL_PRODUCTION=https://merchant.revolut.com/api/merchant/1.0

# Revolut API version header value
REVOLUT_API_VERSION=2025-10-16
# Location ID (provided by user)
REVOLUT_LOCATION_ID=secret

# Public site base URL (must not be localhost for Revolut order URLs)
# For local/dev environments use your public domain too
SITE_PUBLIC_BASE_URL=https://pre.140d.art
SITE_API_BASE_URL=https://api.pre.140d.art

# Test access gate (optional)
# When WEB_APP_HIDDEN is true/1 the web app will be protected by a simple
# password gate intended for non-public test instances. The password itself
# is stored only on the API side in TEST_ACCESS_PASSWORD and verified via
# /api/test-access/verify; the client never exposes it.
WEB_APP_HIDDEN=false
TEST_ACCESS_PASSWORD=secret

# Rate Limiting
#
# CUIDADO con el nombre: pese al sufijo _SECONDS, el middleware multiplica el
# valor por 60 * 1000, así que la ventana está en MINUTOS. El valor por defecto
# de abajo es, por tanto, 1000 peticiones cada 30 MINUTOS por IP (~0,55 req/s
# sostenidas) — no cada 30 segundos.
#
# El renderizado del servidor NO consume esta cuota: sus peticiones entran por
# la red interna de Docker y quedan exentas (api/middleware/rateLimiter.js).
#
# Para medir el techo real de la API en una prueba de carga, sube
# GENERAL_RATE_LIMIT_MAX_REQUESTS a un valor muy alto (p. ej. 1000000) durante
# la ventana de prueba y REVIÉRTELO al terminar. Por encima de 100000 la API
# emite un `warn` al arrancar precisamente para que un olvido no pase
# inadvertido.
GENERAL_RATE_LIMIT_WINDOW_SECONDS=30
GENERAL_RATE_LIMIT_MAX_REQUESTS=1000

# Auth rate limiter (login, register)
AUTH_RATE_LIMIT_WINDOW_SECONDS=30
AUTH_RATE_LIMIT_MAX_REQUESTS=60

# Sensitive operations rate limiter (order creation, payment operations)
SENSITIVE_RATE_LIMIT_WINDOW_SECONDS=30
SENSITIVE_RATE_LIMIT_MAX_REQUESTS=500

# Payment verification rate limiter (status checks, payment retrieval - supports polling)
PAYMENT_VERIFICATION_RATE_LIMIT_WINDOW_SECONDS=15
PAYMENT_VERIFICATION_RATE_LIMIT_MAX_REQUESTS=2000

# Art product inquiry form rate limiter (public endpoint, anti-abuse)
# Despite the *_SECONDS name, the limiter multiplies by 60 (i.e. effectively
# MINUTES — kept for consistency with the other limiter sections above).
# Defaults: 3 inquiries per 60 minutes per IP.
INQUIRY_RATE_LIMIT_WINDOW_SECONDS=60
INQUIRY_RATE_LIMIT_MAX_REQUESTS=3

# Cloudflare Turnstile (captcha) for the public art-product inquiry form.
# Secret key from the Cloudflare dashboard. If empty, the inquiry endpoint
# refuses with 503 CAPTCHA_UNAVAILABLE.
# The matching public site key lives in client/.env as NEXT_PUBLIC_TURNSTILE_SITE_KEY.
# Test secret ("always passes") for development / CI: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# CoA verification rate limiter (NTAG 424 DNA taps from collectors)
# Permissive enough for repeated taps by a legitimate collector, low enough to
# discourage enumeration attacks. Despite the *_SECONDS name, this value is
# multiplied by 60 (i.e. it is actually MINUTES — kept for consistency with
# the other limiter sections above). Defaults: 60 requests per minute per IP.
COA_VERIFY_RATE_LIMIT_WINDOW_SECONDS=1
COA_VERIFY_RATE_LIMIT_MAX_REQUESTS=60

# NTAG 424 DNA (Certificates of Authenticity)
# CRITICAL: these keys are the most sensitive secret of the system.
# Generate with: openssl rand -hex 16
# If they leak: anyone can forge stickers that pass verification.
# If they are lost: no sticker can ever be verified again.
# Custody: print a copy, GPG-encrypt a digital copy, store off-site.
#
# 3 bytes ASCII identifier for our system ("140" = 0x313430). Fixed value.
NTAG424_SYSTEM_ID=313430
# AES-128 key (16 bytes / 32 hex chars) — fixed across all stickers.
# Used by the chip to encrypt the PICC payload (UID + counter).
NTAG424_K_PICC=replace-with-32-hex-chars
# AES-128 key (16 bytes / 32 hex chars) — master for per-UID key diversification.
# Used to derive K0/K1/K3/K4 of each sticker via NXP AN10922 (label||UID||SYSTEM_ID).
NTAG424_MASTER_KEY=replace-with-32-hex-chars

# Salt for HMAC-SHA256 over IP addresses stored in verification_events.
# GDPR-friendly: we never store IPs in clear. Rotate to break correlation
# between past and future events for the same IP.
# Generate with: openssl rand -hex 32
IP_HASH_SALT=replace-with-at-least-32-hex-chars

# Livekit functionality
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# Agora (second streaming provider, selectable per event; coexists with LiveKit)
# All server-side — the App ID travels to the client in the token endpoint
# response (same pattern as LIVEKIT_URL). NO NEXT_PUBLIC_* vars, NO Docker
# build-args. Console setup (console.agora.io), in order:
#   1. Projects → create/use a project in secured mode ("App ID + Token").
#      Copy the App ID → AGORA_APP_ID.
#   2. Edit project → enable the Primary Certificate → AGORA_APP_CERTIFICATE.
#   3. Edit project → ALL FEATURES → Co-Host authentication → Enable.
#      MANDATORY: without it any SUBSCRIBER token can publish (takes ~5 min
#      to propagate).
#   4. Console → RESTful API → Generate → AGORA_CUSTOMER_ID +
#      AGORA_CUSTOMER_SECRET (Basic Auth for moderation kicking rules).
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-app-certificate
AGORA_CUSTOMER_ID=your-agora-restful-customer-id
AGORA_CUSTOMER_SECRET=your-agora-restful-customer-secret

# Agora Interactive Whiteboard (optional phase — leave empty to hide the
# whiteboard toggle entirely). Console: Edit project → ALL FEATURES →
# Whiteboard → Enable (pick an EU region) → Basic information: copy the
# App Identifier, AK and SK. SDK tokens are always generated server-side
# from AK/SK; console-generated tokens are high-privilege, testing only.
AGORA_WHITEBOARD_APP_IDENTIFIER=
AGORA_WHITEBOARD_AK=
AGORA_WHITEBOARD_SK=
AGORA_WHITEBOARD_REGION=eu
# NOTE (client CSP): white-web-sdk loads its modules from blob: URLs, so the
#   client CSP (client/next.config.js) must allow blob: in script-src + connect-src.
# NOTE (benign warning): the console message "Cannot find module
#   'agora-foundation/lib/logger'" / "fallback to Argus" is expected —
#   white-web-sdk peer-wants agora-foundation@3.11.1, unpublished on npm
#   (only 3.11.0 exists). Do NOT force a version; the Argus fallback works.

# Stripe Connect Change #3: paid-event credit scheduler
# Days to wait after events.finished_at before crediting the host's wallet.
EVENT_CREDIT_GRACE_DAYS=1
# Cron schedule for the event credit scheduler (default: hourly).
EVENT_CREDIT_SCHEDULER_CRON=0 * * * *
# Master switch for the event credit scheduler.
EVENT_CREDIT_SCHEDULER_ENABLED=true

# Stripe Connect Change #4: fiscal report (gestoría export)
# Identity block used as the "platform" header in every fiscal export. Missing
# fields do NOT block startup — they only block the export endpoint with a 503.
# See docs/stripe_connect/master_plan.md §9 for the checklist the user must
# complete before going live.
BUSINESS_NAME=140d Galería de Arte
BUSINESS_LEGAL_NAME= 140d Galería de Arte S.L.
BUSINESS_TAX_ID=123456789X
BUSINESS_ADDRESS_LINE1=Paseo del Rector Esperabé 18
BUSINESS_ADDRESS_LINE2=
BUSINESS_ADDRESS_CITY=Salamanca
BUSINESS_ADDRESS_POSTAL_CODE=37008
BUSINESS_ADDRESS_PROVINCE=Salamanca
BUSINESS_ADDRESS_COUNTRY=ES
# Optional; falls back to EMAIL_FROM when empty.
BUSINESS_EMAIL=info@140d.art
BUSINESS_PHONE=623976373

# Order reservation TTL (minutes)
ORDER_RESERVATION_TTL_MINUTES=30

# Sendcloud Shipping Integration
# API credentials from Sendcloud panel (Settings > API > API keys)
SENDCLOUD_API_KEY=your_sendcloud_api_key
SENDCLOUD_API_SECRET=your_sendcloud_api_secret
# How the API client authenticates. The credentials above serve both methods:
# OAuth2 uses them as client id / client secret against
# https://account.sendcloud.com/oauth2/token, Basic Auth sends them directly.
#   auto   (default) OAuth2 first; after one failed retry on 401/403 the request
#          is resolved with Basic Auth and OAuth2 is skipped for five minutes.
#   oauth2 OAuth2 only. A 401/403 after the retry is an error, no fallback.
#   basic  Basic Auth only; the token endpoint is never contacted. Escape hatch
#          if Sendcloud retires the OAuth2 beta.
# Any other value fails startup.
SENDCLOUD_AUTH_MODE=auto
# Webhook signing secret (from Sendcloud Event Subscriptions)
SENDCLOUD_WEBHOOK_SECRET=
# Enable Sendcloud per product type (true/false). When false, legacy shipping is used.
SENDCLOUD_ENABLED_ART=true
SENDCLOUD_ENABLED_OTHERS=true
# Days after delivery to auto-confirm and credit seller earnings
SENDCLOUD_AUTO_CONFIRM_DAYS=14