# Frontend environment identity (build-time). Values: preprod | production.
# Distinguishes preprod from prod; NODE_ENV cannot (next build forces it to production).
# Unset = treated as production (fail-safe). Set to preprod in the preproduction host.
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api
INTERNAL_API_URL=http://api:3001/api
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=some
NEXT_PUBLIC_CART_ADDRESS_FUNC=manual
NEXT_PUBLIC_GOOGLE_PAY_ENABLED=true
NEXT_PUBLIC_GOOGLE_PAY_ENV=TEST
NEXT_PUBLIC_GOOGLE_PAY_MERCHANT_ID=
NEXT_PUBLIC_GOOGLE_PAY_MERCHANT_NAME="140d Galería de Arte (Sandbox)"
NEXT_PUBLIC_GOOGLE_PAY_GATEWAY=example
NEXT_PUBLIC_GOOGLE_PAY_GATEWAY_MERCHANT_ID=exampleGatewayMerchantId
NEXT_PUBLIC_GOOGLE_PAY_LOCALE=es
NEXT_PUBLIC_REVOLUT_LOCALE=es
NEXT_PUBLIC_REVOLUT_MODE=sandbox
NEXT_PUBLIC_REVOLUT_PUBLIC_KEY=some
NEXT_PUBLIC_PAYMENT_TIMEOUT_MS=30000
NEXT_PUBLIC_PAYMENT_PROVIDER=stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=some
WEB_APP_HIDDEN=true
PUBLISHED_VISIBLE=true
NEXT_PUBLIC_LIVEKIT_URL=wss://some.livekit.cloud
# VAT rates are per-seller (users.tax_vat_art / users.tax_vat_other), edited by
# the admin. The former NEXT_PUBLIC_TAX_VAT_* env vars have been removed.
NEXT_PUBLIC_SENDCLOUD_ENABLED_ART=false
NEXT_PUBLIC_SENDCLOUD_ENABLED_OTHERS=true
# Storefront buy/quote toggles (fail-safe: unset = enabled, only 'false' disables).
# NEXT_PUBLIC_PAYMENT_ENABLED: shows "Añadir a la cesta" on art + other detail pages.
# NEXT_PUBLIC_ART_BUY_AVAILABLE: for art only — true = buy (cart), false = "Solicitar cotización".
# Both false on art => no button. See CLAUDE.md for the full truth table.
NEXT_PUBLIC_PAYMENT_ENABLED=true
NEXT_PUBLIC_ART_BUY_AVAILABLE=true
# Newsletter signup chip in the navbar (non-logged users only). Fail-safe: unset
# = visible, only the literal 'false' hides it. Backend signup is also gated by
# MARKETING_EMAILS_ENABLED; keep this 'false' where marketing is off.
NEXT_PUBLIC_NEWSLETTER_ENABLED=true
NEXT_PUBLIC_CDN_URL=https://cdn.140d.art
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Sentry (client). Read via client/lib/sentryEnv.js.
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE: trace sampling for all three Next.js
#   runtimes, default 0.1 when unset. To override it in staging/production it
#   must ALSO go in both client Dockerfiles and both compose build.args blocks.
# NEXT_PUBLIC_SENTRY_ENABLE_DEV: reporting is OFF under `next dev` (every
#   development issue was HMR noise). Only the literal 'true' re-enables it.
#   Deliberately NOT in the Dockerfiles or compose build args — it has no
#   effect outside NODE_ENV=development, where env vars are read at runtime.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_ENABLE_DEV=