# Environment identity (build-time): preprod | production.
# NODE_ENV cannot distinguish preprod from prod; use this instead. Unset = production.
NEXT_PUBLIC_APP_ENV=production

# Site url
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Internal API URL used by Server Components to reach the backend without
# going through nginx. In Docker (see docker-compose.prod.yml) the backend
# service is named `api` and listens on port 3001, so this resolves through
# the Docker network. Leave unset for local dev outside Docker (the page
# falls back to NEXT_PUBLIC_API_URL).
INTERNAL_API_URL=http://api:3001/api

# Google Maps API Key
# Required for address autocomplete feature in checkout
# See GOOGLE_PLACES_SETUP.md for setup instructions
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=secret

# Cart Address Functionality
# Options: "autocomplete" (Google Places autocomplete) or "manual" (manual input)
NEXT_PUBLIC_CART_ADDRESS_FUNC=manual

# Payment Provider: 'revolut' or 'stripe'
NEXT_PUBLIC_PAYMENT_PROVIDER=revolut

# Stripe (required when NEXT_PUBLIC_PAYMENT_PROVIDER=stripe)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Revolut (required when NEXT_PUBLIC_PAYMENT_PROVIDER=revolut)
NEXT_PUBLIC_REVOLUT_LOCALE=es

# Revolut Web SDK mode: 'sandbox' or 'production'
NEXT_PUBLIC_REVOLUT_MODE=sandbox

# Optional: Public API key (used by upsell or certain SDK features)
NEXT_PUBLIC_REVOLUT_PUBLIC_KEY=secret

# Payment timeout in milliseconds (default: 30000 = 30 seconds)
# If payment processing takes longer than this, the user will see an error and be returned to cart
NEXT_PUBLIC_PAYMENT_TIMEOUT_MS=30000

WEB_APP_HIDDEN=true

# App Publication Control
# When set to 'false', shows a "coming soon" page at root and redirects all other routes
# When set to 'true', shows the full application with all features
# Set to 'true' or '1' to publish, any other value keeps it unpublished
PUBLISHED_VISIBLE=false

NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# Dealer commission is now per-seller (served by the API from
# users.dealer_commission_art / users.dealer_commission_other). The former
# NEXT_PUBLIC_DEALER_COMMISSION_* env vars have been removed.

# VAT rates are per-seller (users.tax_vat_art / users.tax_vat_other), edited by
# the admin. The former NEXT_PUBLIC_TAX_VAT_* env vars have been removed.

# Sendcloud shipping integration
# Set to 'true' to enable Sendcloud for art and/or others product types
NEXT_PUBLIC_SENDCLOUD_ENABLED_ART=true
NEXT_PUBLIC_SENDCLOUD_ENABLED_OTHERS=true

# Storefront buy/quote toggles (build-time).
# Fail-safe parse: unset = enabled; only the literal 'false' disables.
# NEXT_PUBLIC_PAYMENT_ENABLED — shows "Añadir a la cesta" on art + other detail pages.
# NEXT_PUBLIC_ART_BUY_AVAILABLE — art only: true = buy (add to cart), false = "Solicitar cotización".
# Truth table (art): both false => no button; both true => cart; otherwise => quote.
# For 'other', only NEXT_PUBLIC_PAYMENT_ENABLED applies.
NEXT_PUBLIC_PAYMENT_ENABLED=true
NEXT_PUBLIC_ART_BUY_AVAILABLE=true

# Newsletter signup chip in the navbar (shown only to non-logged visitors).
# Fail-safe parse: unset = visible; only the literal 'false' hides it. The
# backend signup endpoint is independently gated by MARKETING_EMAILS_ENABLED.
NEXT_PUBLIC_NEWSLETTER_ENABLED=true

# Meta Pixel (Instagram/Facebook Ads), build-time.
# Id del conjunto de datos que da el Administrador de eventos de Meta.
# Fail-safe INVERSO al resto de flags: vacío o ausente = desactivado; no se
# inyecta el script ni se emite ningún evento (PageView, ViewContent,
# AddToCart, InitiateCheckout, Purchase).
NEXT_PUBLIC_META_PIXEL_ID=

NEXT_PUBLIC_CDN_URL=https://cdn.140d.art

# Cloudflare Turnstile (captcha) for the public art-product inquiry form.
# Site key from the Cloudflare dashboard. If empty, the "haz click aquí" link
# on the art product detail page is hidden.
# The matching secret key lives in api/.env as TURNSTILE_SECRET.
# Test site key ("always passes") for development / CI: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Sentry — trace sampling for the three Next.js runtimes (browser, node, edge).
# Read via client/lib/sentryEnv.js. Defaults to 0.1 when unset; the Sentry
# scaffolding shipped 1, which burns quota. To override this in staging or
# production you must ALSO add it to client/Dockerfile.staging,
# client/Dockerfile.prod and the build.args of both compose files — it is
# inlined at build time like every other NEXT_PUBLIC_*.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Sentry — escape hatch to report from local development. Reporting is OFF
# under `next dev`, because every issue this project ever received from
# environment:development was an HMR / Fast Refresh artefact, plus session
# replays of localhost. Only the literal 'true' re-enables it.
#
# Deliberately NOT wired into client/Dockerfile.staging, client/Dockerfile.prod
# or the compose build args, unlike other NEXT_PUBLIC_* vars: it only has an
# effect when NODE_ENV=development, i.e. under `next dev`, where there is no
# build step and env vars are read at runtime. Adding it to the production
# images would be dead code implying development reporting can be toggled
# there.
NEXT_PUBLIC_SENTRY_ENABLE_DEV=